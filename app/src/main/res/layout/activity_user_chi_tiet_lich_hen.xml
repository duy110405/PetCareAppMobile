<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chi tiết lịch hẹn của bạn"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:id="@+id/tvPetName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thú cưng: " android:textSize="18sp" android:textStyle="bold" android:textColor="#111111"/>
            <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thời gian: " android:layout_marginTop="12dp" android:textColor="#333"/>
            <TextView android:id="@+id/tvBranch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chi nhánh: " android:layout_marginTop="8dp" android:textColor="#333"/>
            <TextView android:id="@+id/tvServices" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dịch vụ: " android:layout_marginTop="8dp" android:textColor="#333"/>
            <TextView android:id="@+id/tvTotalPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tổng tiền: " android:layout_marginTop="8dp" android:textStyle="bold" android:textColor="#D32F2F"/>
            <TextView android:id="@+id/tvNote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ghi chú: " android:layout_marginTop="8dp" android:textColor="#333"/>

            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trạng thái" android:layout_marginTop="16dp" android:textStyle="bold" android:textColor="#FF9800" android:textSize="16sp"/>

            <TextView android:id="@+id/tvRejectReason" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lý do từ chối: " android:visibility="gone" android:layout_marginTop="12dp" android:textColor="#D32F2F" android:textStyle="italic"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Khối hiển thị Kết quả khám (Chỉ hiện khi trạng thái là Hoàn thành) -->
    <LinearLayout
        android:id="@+id/layoutKetQuaKham"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        android:background="@drawable/bg_card"
        android:visibility="gone"> <!-- Mặc định ẩn -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KẾT QUẢ KHÁM &amp; ĐIỀU TRỊ"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtUserTenBacSi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bác sĩ phụ trách: ..."
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtUserChanDoan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chẩn đoán: ..."
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtUserDonThuoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đơn thuốc &amp; Dặn dò: ..."
            android:textColor="#333333"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quay lại"
        android:layout_marginTop="24dp"
        app:backgroundTint="#9E9E9E"/>



</LinearLayout>