<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- LOGO (PHỤC VỤ ANIMATION) -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/ic_launcher_foreground"
        android:layout_marginBottom="16dp"/>

    <!-- APP NAME -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PETCARE"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="10dp"/>

    <!-- SUB TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ứng dụng hỗ trợ chăm sóc thú cưng"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="20dp"
        android:gravity="center"/>

    <!-- SCHOOL INFO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Khoa Công nghệ thông tin"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/text_primary"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trường Đại học Mở Hà Nội"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp"/>

    <!-- GROUP TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhóm thực hiện:"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp"/>

    <!-- MEMBER LIST -->
    <TextView
        android:id="@+id/tvMembers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Lê Tài Quốc Huy\n2. Đỗ Thùy Dương\n3. Trần Khánh Duy\n4. Lê Đức Hiếu"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingExtra="4dp"/>

    <!-- LOADING -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminate="true"/>

</LinearLayout>