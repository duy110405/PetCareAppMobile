<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HEADER (KHÔNG ĐỔI LOGIC) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#6D6D6D"
        android:padding="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lịch hẹn"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- DASHBOARD (GIỮ ID) -->
    <LinearLayout
        android:id="@+id/layoutDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:weightSum="4">

        <TextView
            android:id="@+id/tvPendingCount"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0\nChờ"
            android:textStyle="bold"
            android:background="#FFF3E0"/>

        <TextView
            android:id="@+id/tvApprovedCount"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0\nDuyệt"
            android:textStyle="bold"
            android:background="#E8F5E9"/>

        <TextView
            android:id="@+id/tvCancelledCount"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0\nHủy"
            android:textStyle="bold"
            android:background="#EEEEEE"/>

        <TextView
            android:id="@+id/tvTotalCount"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0\nTổng"
            android:textStyle="bold"
            android:background="#E3F2FD"/>

    </LinearLayout>



    <TextView
        android:id="@+id/tvFilterSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đang lọc: Tất cả"
        android:padding="10dp"
        android:background="#EEEEEE"
        android:textColor="#444444"
        android:visibility="gone"/>
    <!-- FILTER -->
    <LinearLayout
        android:id="@+id/filterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FAFAFA">

            <!-- SECTION STATUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lọc theo trạng thái"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- SPACE -->
            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"/>

            <!-- SECTION BRANCH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lọc theo chi nhánh"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spBranch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- SPACE -->
            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"/>

            <!-- DATE BUTTON (KHÔNG ĐỔI ID) -->
            <Button
                android:id="@+id/btnPickDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chọn ngày"
                android:backgroundTint="#EEEEEE"
                android:textColor="#333333"/>

            <!-- FILTER BUTTON -->
            <Button
                android:id="@+id/btnFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lọc"
                android:layout_marginTop="8dp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"/>

            <!-- EMPTY STATE -->
            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Không có lịch hẹn"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="#888888"
                android:visibility="gone"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- COUNT -->
    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 lịch hẹn"
        android:textStyle="bold"
        android:padding="10dp"
        android:textColor="#333333"/>

    <!-- LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"/>
</LinearLayout>