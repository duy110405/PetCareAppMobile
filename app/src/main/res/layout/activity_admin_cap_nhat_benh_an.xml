<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E64FE"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Hồ sơ Bệnh án"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/btnLuuBenhAn"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. CHỈ SỐ SINH TỒN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Chỉ số sinh tồn"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                android:layout_marginBottom="16dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="12dp">

                    <EditText
                        android:id="@+id/edtThanNhiet"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="Nhiệt độ (°C)"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/edtNhipTim"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="Nhịp tim (lần/phút)"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/edtHuyetAp"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="Huyết áp"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/edtNhipTho"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="Nhịp thở"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"/>
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. KHÁM LÂM SÀNG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Khám lâm sàng"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtTrieuChung"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_input"
                android:hint="Triệu chứng chính..."
                android:gravity="top|start"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/edtTinhTrang"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_input"
                android:hint="Tình trạng tổng quát (Thể trạng, Ăn, Uống, Lông, Da...)"
                android:gravity="top|start"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:textSize="14sp"/>

            <!-- 3. KẾT LUẬN & ĐIỀU TRỊ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Kết luận &amp; Điều trị"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/edtKetLuan"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_input"
                android:hint="Kết luận bệnh..."
                android:gravity="top|start"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/edtDonThuoc"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_input"
                android:hint="Đơn thuốc (Tên thuốc - Liều lượng - Số lượng)"
                android:gravity="top|start"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/edtNgayTaiKham"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="Ngày hẹn tái khám (VD: 15/06/2026)"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="24dp"
                android:textSize="14sp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnLuuBenhAn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="LƯU BỆNH ÁN &amp; HOÀN THÀNH"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#4CAF50"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>