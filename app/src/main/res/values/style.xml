<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- FIX ERROR -->
    <style name="PetCare"/>

    <!-- CARD -->
    <style name="PetCare.Card">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- BUTTON -->
    <style name="PetCare.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- BUTTON PRIMARY -->
    <style
        name="PetCare.Button.Primary"
        parent="@style/PetCare.Button"/>

    <!-- INPUT -->
    <style
        name="PetCare.Input"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxStrokeColor">@color/border</item>

        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>

    </style>

</resources>